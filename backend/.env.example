# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
# Must be the service_role secret (JWT, starts with eyJ…), NOT the anon/publishable key.
# Dashboard: Project Settings → API → service_role → Reveal / copy secret.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:8081,exp://192.168.1.0:8081

# Alert Thresholds
FALL_ALERT_ENABLED=true
